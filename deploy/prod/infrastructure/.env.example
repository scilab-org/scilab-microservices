############################################
#                  GENERAL
############################################
TZ=Asia/Ho_Chi_Minh

############################################
#       REVERSE PROXY / LOAD BALANCER
############################################
NGINX_IMAGE_NAME=nginx:1.29.4
CERTBOT_IMAGE_NAME=certbot/certbot:latest
CERTBOT_EMAIL=CHANGE_ME_EMAIL
KEYCLOAK_SERVER_DOMAIN=auth.hyperdatalab.site
MINIO_DOMAIN=minio.hyperdatalab.site
POSTGRES_DOMAIN=postgres.hyperdatalab.site
RABBITMQ_DOMAIN=rabbitmq.hyperdatalab.site
RABBITMQ_ADMIN_DOMAIN=rabbitmq-admin.hyperdatalab.site

############################################
#                DATABASES
############################################
# Postgres
POSTGRES_IMAGE_NAME=postgres:17.7
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=keycloak_db,lab_service_db,management_service_db,user_service_db

############################################
#             CACHE / MQ / MAIL
############################################
# Redis
REDIS_IMAGE_NAME=redis:8.6.1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_IMAGE_NAME=rabbitmq:4.1-management
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

############################################
#          STORAGE / OBJECT STORE
############################################
# MinIO
MINIO_IMAGE_NAME=quay.io/minio/minio:RELEASE.2025-07-23T15-54-02Z
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_SERVER_URL=https://minio.hyperdatalab.site
MINIO_BROWSER_REDIRECT_URL=https://minio.hyperdatalab.site/console
MINIO_API_PORT=9000
MINIO_UI_PORT=9001

############################################
#            IDENTITY / SECURITY
############################################
# Keycloak
KEYCLOAK_IMAGE_NAME=quay.io/keycloak/keycloak:26.5.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HOSTNAME=auth.hyperdatalab.site
KEYCLOAK_DB_URL=jdbc:postgresql://postgres-sql:5432/keycloak_db
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD

